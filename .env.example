# Web Push VAPID Keys
# Generate with: node -e "const webpush = require('web-push'); const keys = webpush.generateVAPIDKeys(); console.log('Public:', keys.publicKey); console.log('Private:', keys.privateKey)"
VITE_VAPID_PUBLIC_KEY=your_public_key_here
VAPID_PUBLIC_KEY=your_public_key_here
VAPID_PRIVATE_KEY=your_private_key_here

# Notification API Token (for authorization)
# Generate a random token and use it for sending notifications
NOTIFICATION_AUTH_TOKEN=your_random_token_here
